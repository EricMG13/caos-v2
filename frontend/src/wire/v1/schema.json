  "UploadBody": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "set_versions": {"items": {"$ref": "#/$defs/SetVersion"}, "maxItems": 1000, "title": "Set Versions", "type": "array"}, "sources": {"items": {"$ref": "#/$defs/SourceRow"}, "maxItems": 1000, "title": "Sources", "type": "array"}}, "required": ["case_id", "sources", "set_versions"], "title": "UploadBody", "type": "object"},
  "UploadDocument": {"additionalProperties": false, "properties": {"body": {"$ref": "#/$defs/UploadBody"}, "chrome": {"$ref": "#/$defs/Chrome"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "observed_empty": {"title": "Observed Empty", "type": "boolean"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["chrome", "body", "observed_at", "observed_empty", "status", "notes"], "title": "UploadDocument", "type": "object"},
  "WorkView": {"additionalProperties": false, "description": "The run's `run_work` row, when it has been enqueued.", "properties": {"cancel_requested": {"title": "Cancel Requested", "type": "boolean"}, "state": {"enum": ["QUEUED", "CLAIMED", "STOPPED", "DONE"], "title": "State", "type": "string"}, "stop_code": {"anyOf": [{"$ref": "#/$defs/RefusalCode"}, {"type": "null"}]}}, "required": ["state", "stop_code", "cancel_requested"], "title": "WorkView", "type": "object"}

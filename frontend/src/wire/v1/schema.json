  "NodeView": {"additionalProperties": false, "description": "A node's state and the reason for it.", "properties": {"awaiting_gate": {"title": "Awaiting Gate", "type": "boolean"}, "gate_verdict": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Gate Verdict"}, "module_id": {"maxLength": 256, "title": "Module Id", "type": "string"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "stage": {"title": "Stage", "type": "integer"}, "state": {"$ref": "#/$defs/NodeState"}, "waiting_on": {"items": {"$ref": "#/$defs/EdgeView"}, "maxItems": 256, "title": "Waiting On", "type": "array"}}, "required": ["route_node_id", "module_id", "stage", "state", "waiting_on", "awaiting_gate", "gate_verdict"], "title": "NodeView", "type": "object"},
  "PendingNode": {"additionalProperties": false, "properties": {"module_id": {"maxLength": 256, "title": "Module Id", "type": "string"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "state": {"$ref": "#/$defs/NodeState"}}, "required": ["route_node_id", "module_id", "state"], "title": "PendingNode", "type": "object"},
  "RectView": {"additionalProperties": false, "description": "A rectangle in page coordinates, from the record.", "properties": {"x0": {"title": "X0", "type": "number"}, "x1": {"title": "X1", "type": "number"}, "y0": {"title": "Y0", "type": "number"}, "y1": {"title": "Y1", "type": "number"}}, "required": ["x0", "y0", "x1", "y1"], "title": "RectView", "type": "object"},
  "RefusalBody": {"additionalProperties": false, "description": "Everything a declined request says: the code and what clears it.", "properties": {"clears": {"maxLength": 4096, "title": "Clears", "type": "string"}, "code": {"$ref": "#/$defs/RefusalCode"}}, "required": ["code", "clears"], "title": "RefusalBody", "type": "object"},
  "RefusalCode": {"description": "Every reason the host declines. Public-safe by construction.", "enum": ["BOUNDARY_TEXT_INVALID", "BOUNDARY_TEXT_TOO_LONG", "BLOB_DIGEST_MISMATCH", "BLOB_NOT_FOUND", "BLOB_ADDRESS_INVALID", "RUN_NOT_FOUND", "RUN_NOT_RUNNING", "LEASE_NOT_HELD", "RUN_CANCEL_REQUESTED", "RUN_NODES_UNACCEPTED", "RUN_TERMINAL_STALE", "ATTEMPT_NOT_FOUND", "ATTEMPT_LIMIT_REACHED", "CALL_OUTCOME_INVALID", "CALL_OUTCOME_CONFLICT", "CALL_OUTCOME_LEGACY", "NODE_ALREADY_ACCEPTED", "MONEY_NOT_DECIMAL", "MONEY_INVALID", "BUDGET_ALREADY_RESERVED", "BUDGET_NOT_RESERVED", "BUDGET_CEILING_REACHED", "PROVIDER_NOT_CONFIGURED", "PROVIDER_CALL_INVALID", "CONTEXT_OVER_CEILING", "PROVIDER_UNAVAILABLE", "PROVIDER_OUTPUT_TRUNCATED", "PROVIDER_REFUSED", "PROVIDER_RESPONSE_INVALID", "AUTHORITY_BYTES_MISMATCH", "AUTHORITY_MODULE_UNKNOWN", "ENVELOPE_INVALID", "ENVELOPE_UNDECLARED_FIELD", "ENVELOPE_UNCITED_CLAIM", "HANDOFF_MALFORMED", "HANDOFF_BLOCKED", "HANDOFF_IDENTITY_MISMATCH", "HANDOFF_INCOMPLETE", "HANDOFF_UNDECLARED_FIELD", "HANDOFF_MODULE_UNSUPPORTED", "ARTIFACT_RECORD_MISMATCH", "READINESS_INVALID", "READINESS_INCOMPLETE", "NOT_AUTHENTICATED", "ENDPOINT_NOT_FOUND", "NOT_AUTHORISED", "METHODOLOGY_INPUT_INVALID", "FORECAST_CHAIN_BROKEN", "FORECAST_RESIDUAL_UNRECONCILED", "FORECAST_DRIVER_NOT_READY", "DELIVERABLE_PAYLOAD_INVALID", "DELIVERABLE_UNCITED_FIGURE", "DELIVERABLE_NOT_SIGNED", "DELIVERABLE_NOT_FROZEN", "DELIVERABLE_MOVED_SINCE_SIGNING", "DELIVERABLE_ALREADY_FILED", "DELIVERABLE_ALREADY_FROZEN", "APPROVER_NOT_INDEPENDENT", "CASE_NOT_FOUND", "SOURCE_PACK_EMPTY", "SOURCE_NOT_READABLE", "SOURCE_ENCRYPTED", "SOURCE_HAS_NO_TEXT", "SOURCE_TOO_LARGE", "SOURCE_EXTRACTION_TIMEOUT", "SOURCE_IDENTITY_INVALID", "EVIDENCE_NOT_AVAILABLE", "CITATION_NOT_LOCATED", "CITATION_AMBIGUOUS", "CITATION_NOT_DELIVERED", "ROUTE_PROFILE_UNKNOWN", "ROUTE_SELECTION_UNKNOWN", "ROUTE_EXTENSION_OWNER_MISSING", "ROUTE_HAS_A_CYCLE", "ROUTE_DUPLICATE_MODULE", "ROUTE_ALREADY_PINNED", "ROUTE_IDENTITY_IN
  "RunBody": {"additionalProperties": false, "description": "Latest and displayed run are separate identities (item 1).", "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "displayed_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Displayed Run Id"}, "latest_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Latest Run Id"}, "run": {"anyOf": [{"$ref": "#/$defs/RunView"}, {"type": "null"}]}, "runs": {"items": {"$ref": "#/$defs/RunSummary"}, "maxItems": 200, "title": "Runs", "type": "array"}}, "required": ["case_id", "latest_run_id", "displayed_run_id", "runs", "run"], "title": "RunBody", "type": "object"},
  "RunSectionDocument": {"additionalProperties": false, "properties": {"body": {"$ref": "#/$defs/RunBody"}, "chrome": {"$ref": "#/$defs/Chrome"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "observed_empty": {"title": "Observed Empty", "type": "boolean"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["chrome", "body", "observed_at", "observed_empty", "status", "notes"], "title": "RunSectionDocument", "type": "object"},
  "RunSubjectView": {"additionalProperties": false, "description": "The pinned run subject.", "properties": {"analysis_date": {"maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "title": "Analysis Date", "type": "string"}, "issuer_id": {"maxLength": 128, "title": "Issuer Id", "type": "string"}, "issuer_name": {"maxLength": 4096, "title": "Issuer Name", "type": "string"}, "reporting_period": {"maxLength": 4096, "title": "Reporting Period", "type": "string"}}, "required": ["issuer_id", "issuer_name", "reporting_period", "analysis_date"], "title": "RunSubjectView", "type": "object"},
  "RunSummary": {"additionalProperties": false, "description": "One run of a case, as a list names it.", "properties": {"created_at": {"format": "date-time", "title": "Created At", "type": "string"}, "profile_id": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Profile Id"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "selection_id": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Selection Id"}, "status": {"enum": ["RUNNING", "COMPLETE", "FAILED", "BLOCKED"], "title": "Status", "type": "string"}}, "required": ["run_id", "status", "created_at", "profile_id", "selection_id"], "title": "RunSummary", "type": "object"},
  "RunView": {"additionalProperties": false, "description": "The displayed run. Node states are recomputed, never stored.", "properties": {"attempts": {"items": {"$ref": "#/$defs/AttemptView"}, "maxItems": 4096, "title": "Attempts", "type": "array"}, "build_id": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Build Id"}, "created_at": {"format": "date-time", "title": "Created At", "type": "string"}, "gates": {"items": {"$ref": "#/$defs/GateView"}, "maxItems": 2, "title": "Gates", "type": "array"}, "nodes": {"items": {"$ref": "#/$defs/NodeView"}, "maxItems": 256, "title": "Nodes", "type": "array"}, "route_digest": {"anyOf": [{"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}], "title": "Route Digest"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "source_set_version": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Source Set Version"}, "status": {"enum": ["RUNNING", "COMPLETE", "FAILED", "BLOCKED"], "title": "Status", "type": "string"}, "subject": {"anyOf": [{"$ref": "#/$defs/RunSubjectView"}, {"type": "null"}]}}, "required": ["run_id", "status", "created_at", "route_digest", "build_id", "source_set_version", "subject", "gates", "nodes", "attempts"], "title": "RunView", "type": "object"},
  "SectionNote": {"description": "Why a section document is partial or empty. Closed.", "enum": ["LIST_TRUNCATED", "ROUTE_NOT_PINNED", "HANDOFFS_PENDING"], "title": "SectionNote", "type": "string"},

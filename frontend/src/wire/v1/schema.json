  "SetVersion": {"additionalProperties": false, "properties": {"fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Fingerprint", "type": "string"}, "member_count": {"title": "Member Count", "type": "integer"}, "version": {"title": "Version", "type": "integer"}}, "required": ["version", "fingerprint", "member_count"], "title": "SetVersion", "type": "object"},
  "SourceRow": {"additionalProperties": false, "description": "One admitted source; withdrawal is read live.", "properties": {"admitted_at": {"format": "date-time", "title": "Admitted At", "type": "string"}, "document_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Document Sha256", "type": "string"}, "extractor_identity": {"anyOf": [{"maxLength": 4096, "type": "string"}, {"type": "null"}], "title": "Extractor Identity"}, "filename": {"maxLength": 4096, "title": "Filename", "type": "string"}, "set_versions": {"items": {"type": "integer"}, "maxItems": 1000, "title": "Set Versions", "type": "array"}, "source_id": {"format": "uuid", "title": "Source Id", "type": "string"}, "withdrawn_at": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}], "title": "Withdrawn At"}}, "required": ["source_id", "filename", "document_sha256", "admitted_at", "withdrawn_at", "extractor_identity", "set_versions"], "title": "SourceRow", "type": "object"},
  "Standing": {"description": "What a member may do on one case, least to most.", "enum": ["READER", "WRITER", "APPROVER", "ADMIN"], "title": "Standing", "type": "string"},

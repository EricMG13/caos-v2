  "UploadBody": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "set_versions": {"items": {"$ref": "#/$defs/SetVersion"}, "maxItems": 1000, "title": "Set Versions", "type": "array"}, "sources": {"items": {"$ref": "#/$defs/SourceRow"}, "maxItems": 1000, "title": "Sources", "type": "array"}}, "required": ["case_id", "sources", "set_versions"], "title": "UploadBody", "type": "object"},

{"$defs": {
  "ActionName": {"description": "Every governed command a section can offer. Closed.", "enum": ["CREATE_CASE", "ADMIT_SOURCES", "CREATE_RUN", "PIN_RUN_INPUT", "APPROVE_SOURCE_SET", "APPROVE_RESEARCH_PLAN", "START_RUN", "RETRY_RUN", "CANCEL_RUN"], "title": "ActionName", "type": "string"},
  "ActionView": {"additionalProperties": false, "description": "One action as the server judged it: available (`refusal` null) or refused\nwith the code the command would answer. Advisory; the command rechecks.", "properties": {"action": {"$ref": "#/$defs/ActionName"}, "refusal": {"anyOf": [{"$ref": "#/$defs/RefusalBody"}, {"type": "null"}]}}, "required": ["action", "refusal"], "title": "ActionView", "type": "object"},
  "AnalysisBody": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "displayed_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Displayed Run Id"}, "handoffs": {"items": {"$ref": "#/$defs/HandoffView"}, "maxItems": 256, "title": "Handoffs", "type": "array"}, "latest_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Latest Run Id"}, "pending": {"items": {"$ref": "#/$defs/PendingNode"}, "maxItems": 256, "title": "Pending", "type": "array"}, "subject": {"anyOf": [{"$ref": "#/$defs/RunSubjectView"}, {"type": "null"}]}}, "required": ["case_id", "latest_run_id", "displayed_run_id", "subject", "handoffs", "pending"], "title": "AnalysisBody", "type": "object"},
  "AnalysisDocument": {"additionalProperties": false, "properties": {"body": {"$ref": "#/$defs/AnalysisBody"}, "chrome": {"$ref": "#/$defs/Chrome"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "observed_empty": {"title": "Observed Empty", "type": "boolean"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["chrome", "body", "observed_at", "observed_empty", "status", "notes"], "title": "AnalysisDocument", "type": "object"},
  "ApproveGate": {"additionalProperties": false, "properties": {"input_fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Input Fingerprint", "type": "string"}, "preview_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Preview Sha256", "type": "string"}}, "required": ["preview_sha256", "input_fingerprint"], "title": "ApproveGate", "type": "object"},
  "AttemptView": {"additionalProperties": false, "properties": {"accepted": {"title": "Accepted", "type": "boolean"}, "attempt_id": {"format": "uuid", "title": "Attempt Id", "type": "string"}, "ordinal": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Ordinal"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "started_at": {"format": "date-time", "title": "Started At", "type": "string"}}, "required": ["attempt_id", "route_node_id", "ordinal", "started_at", "accepted"], "title": "AttemptView", "type": "object"},
  "CancelRun": {"additionalProperties": false, "properties": {}, "required": [], "title": "CancelRun", "type": "object"},
  "CaseCreated": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}}, "required": ["case_id"], "title": "CaseCreated", "type": "object"},
  "CaseRow": {"additionalProperties": false, "description": "One case the actor holds live standing on.", "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "created_at": {"format": "date-time", "title": "Created At", "type": "string"}, "latest_run": {"anyOf": [{"$ref": "#/$defs/RunSummary"}, {"type": "null"}]}, "live_sources": {"title": "Live Sources", "type": "integer"}, "standing": {"$ref": "#/$defs/Standing"}, "title": {"maxLength": 4096, "title": "Title", "type": "string"}}, "required": ["case_id", "title", "created_at", "standing", "live_sources", "latest_run"], "title": "CaseRow", "type": "object"},
  "Chrome": {"additionalProperties": false, "description": "The authority facts the client composes its chrome from.", "properties": {"actions": {"items": {"$ref": "#/$defs/ActionView"}, "maxItems": 9, "title": "Actions", "type": "array"}, "served_role": {"$ref": "#/$defs/ServedRole"}, "subject": {"anyOf": [{"$ref": "#/$defs/Subject"}, {"type": "null"}]}}, "required": ["subject", "served_role", "actions"], "title": "Chrome", "type": "object"},
  "CitationView": {"additionalProperties": false, "description": "A host-verified citation; withdrawal is read live. `source_id` is the\npinned source the document resolves to, which addresses its page (4.4).", "properties": {"document_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Document Sha256", "type": "string"}, "filename": {"maxLength": 4096, "title": "Filename", "type": "string"}, "matched_text": {"maxLength": 65536, "title": "Matched Text", "type": "string"}, "page": {"title": "Page", "type": "integer"}, "rects": {"items": {"$ref": "#/$defs/RectView"}, "maxItems": 256, "title": "Rects", "type": "array"}, "source_id": {"format": "uuid", "title": "Source Id", "type": "string"}, "withdrawn_at": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}], "title": "Withdrawn At"}}, "required": ["document_sha256", "source_id", "filename", "page", "matched_text", "rects", "withdrawn_at"], "title": "CitationView", "type": "object"},
  "CreateCase": {"additionalProperties": false, "properties": {"title": {"maxLength": 256, "title": "Title", "type": "string"}}, "required": ["title"], "title": "CreateCase", "type": "object"},
  "CreateRun": {"additionalProperties": false, "properties": {"profile_id": {"maxLength": 256, "title": "Profile Id", "type": "string"}, "selection_id": {"maxLength": 256, "title": "Selection Id", "type": "string"}}, "required": ["profile_id", "selection_id"], "title": "CreateRun", "type": "object"},
  "DirectoryBody": {"additionalProperties": false, "properties": {"cases": {"items": {"$ref": "#/$defs/CaseRow"}, "maxItems": 200, "title": "Cases", "type": "array"}}, "required": ["cases"], "title": "DirectoryBody", "type": "object"},
  "DirectoryDocument": {"additionalProperties": false, "properties": {"body": {"$ref": "#/$defs/DirectoryBody"}, "chrome": {"$ref": "#/$defs/Chrome"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "observed_empty": {"title": "Observed Empty", "type": "boolean"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["chrome", "body", "observed_at", "observed_empty", "status", "notes"], "title": "DirectoryDocument", "type": "object"},
  "EdgeType": {"description": "The bundle's words, unchanged (CONTEXT.md).", "enum": ["REQUIRED", "CONDITIONAL", "QA_GATE", "OPTIONAL", "ADVISORY"], "title": "EdgeType", "type": "string"},
  "EdgeView": {"additionalProperties": false, "description": "One dependency a node is still waiting for, with its type.", "properties": {"source": {"maxLength": 256, "title": "Source", "type": "string"}, "type": {"$ref": "#/$defs/EdgeType"}}, "required": ["source", "type"], "title": "EdgeView", "type": "object"},
  "EventName": {"enum": ["run_progress", "handoff_accepted", "run_terminal", "sources_changed", "runs_changed"], "type": "string"},
  "FrameView": {"additionalProperties": false, "description": "A page's frame in the coordinates its rectangles are stored in.", "properties": {"x0": {"title": "X0", "type": "number"}, "x1": {"title": "X1", "type": "number"}, "y0": {"title": "Y0", "type": "number"}, "y1": {"title": "Y1", "type": "number"}, "y_axis": {"enum": ["down", "up"], "title": "Y Axis", "type": "string"}}, "required": ["x0", "y0", "x1", "y1", "y_axis"], "title": "FrameView", "type": "object"},
  "Gate": {"description": "The digest-bound interrupts a run can wait on.", "enum": ["SOURCE_SET", "RESEARCH_PLAN"], "title": "Gate", "type": "string"},
  "GateApproved": {"additionalProperties": false, "properties": {"gate": {"$ref": "#/$defs/Gate"}, "input_fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Input Fingerprint", "type": "string"}, "preview_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Preview Sha256", "type": "string"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}}, "required": ["run_id", "gate", "preview_sha256", "input_fingerprint"], "title": "GateApproved", "type": "object"},
  "GatePreviewDocument": {"additionalProperties": false, "description": "The exact content an approver is shown, and the digests to submit.", "properties": {"content": {"maxLength": 26214400, "title": "Content", "type": "string"}, "gate": {"$ref": "#/$defs/Gate"}, "input_fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Input Fingerprint", "type": "string"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "preview_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Preview Sha256", "type": "string"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}}, "required": ["run_id", "gate", "content", "preview_sha256", "input_fingerprint", "observed_at"], "title": "GatePreviewDocument", "type": "object"},
  "GateState": {"description": "Whether the run may pass, judged against the content that is there now.", "enum": ["OPEN", "RELEASED"], "title": "GateState", "type": "string"},
  "GateView": {"additionalProperties": false, "properties": {"gate": {"$ref": "#/$defs/Gate"}, "state": {"$ref": "#/$defs/GateState"}}, "required": ["gate", "state"], "title": "GateView", "type": "object"},
  "GlobalRole": {"description": "What kind of account this is. Not what it may do to a given case.", "enum": ["READER", "ANALYST", "ADMIN"], "title": "GlobalRole", "type": "string"},
  "HandoffView": {"additionalProperties": false, "description": "One accepted handoff, labelled per §46.3.", "properties": {"accepted_at": {"format": "date-time", "title": "Accepted At", "type": "string"}, "artifact_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Artifact Sha256", "type": "string"}, "committee_status": {"maxLength": 256, "title": "Committee Status", "type": "string"}, "confidence_band": {"maxLength": 256, "title": "Confidence Band", "type": "string"}, "confidence_score": {"title": "Confidence Score", "type": "integer"}, "decision_scope": {"maxLength": 256, "title": "Decision Scope", "type": "string"}, "host_calculation": {"const": "NONE", "title": "Host Calculation", "type": "string"}, "limitation_flags": {"items": {"maxLength": 4096, "type": "string"}, "maxItems": 256, "title": "Limitation Flags", "type": "array"}, "model_analysis": {"maxLength": 26214400, "title": "Model Analysis", "type": "string"}, "module_id": {"maxLength": 256, "title": "Module Id", "type": "string"}, "qa_status": {"maxLength": 256, "title": "Qa Status", "type": "string"}, "record_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Record Sha256", "type": "string"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "screening_only": {"title": "Screening Only", "type": "boolean"}, "source_facts": {"items": {"$ref": "#/$defs/CitationView"}, "maxItems": 1024, "title": "Source Facts", "type": "array"}, "validation_warnings": {"items": {"maxLength": 4096, "type": "string"}, "maxItems": 256, "title": "Validation Warnings", "type": "array"}}, "required": ["route_node_id", "module_id", "artifact_sha256", "record_sha256", "accepted_at", "qa_status", "committee_status", "confidence_score", "confidence_band", "limitation_flags", "validation_warnings", "decision_scope", "screening_only", "source_facts", "model_analysis", "host_calculation"], "title": "HandoffView", "type": "object"},
  "ModelBody": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "displayed_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Displayed Run Id"}, "forecast": {"anyOf": [{"$ref": "#/$defs/ModelForecast"}, {"type": "null"}]}, "latest_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Latest Run Id"}, "subject": {"anyOf": [{"$ref": "#/$defs/RunSubjectView"}, {"type": "null"}]}, "unavailable_reason": {"anyOf": [{"const": "NO_ACCEPTED_FORECAST", "type": "string"}, {"type": "null"}], "title": "Unavailable Reason"}}, "required": ["case_id", "latest_run_id", "displayed_run_id", "subject", "forecast", "unavailable_reason"], "title": "ModelBody", "type": "object"},
  "ModelDocument": {"additionalProperties": false, "properties": {"body": {"$ref": "#/$defs/ModelBody"}, "chrome": {"$ref": "#/$defs/Chrome"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "observed_empty": {"title": "Observed Empty", "type": "boolean"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["chrome", "body", "observed_at", "observed_empty", "status", "notes"], "title": "ModelDocument", "type": "object"},
  "ModelForecast": {"additionalProperties": false, "properties": {"accepted_at": {"format": "date-time", "title": "Accepted At", "type": "string"}, "artifact_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Artifact Sha256", "type": "string"}, "currency": {"maxLength": 3, "pattern": "^[A-Z]{3}$", "title": "Currency", "type": "string"}, "limitation_flags": {"items": {"maxLength": 4096, "type": "string"}, "maxItems": 256, "title": "Limitation Flags", "type": "array"}, "perimeter": {"maxLength": 4096, "title": "Perimeter", "type": "string"}, "periods": {"items": {"$ref": "#/$defs/ModelPeriod"}, "maxItems": 240, "title": "Periods", "type": "array"}, "qa_status": {"maxLength": 256, "title": "Qa Status", "type": "string"}, "record_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Record Sha256", "type": "string"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "scale": {"enum": ["units", "thousands", "millions", "billions"], "title": "Scale", "type": "string"}, "validation_warnings": {"items": {"maxLength": 4096, "type": "string"}, "maxItems": 256, "title": "Validation Warnings", "type": "array"}}, "required": ["route_node_id", "artifact_sha256", "record_sha256", "accepted_at", "qa_status", "limitation_flags", "validation_warnings", "currency", "scale", "perimeter", "periods"], "title": "ModelForecast", "type": "object"},
  "ModelPeriod": {"additionalProperties": false, "properties": {"case": {"maxLength": 4096, "title": "Case", "type": "string"}, "days": {"maxLength": 3, "pattern": "^[0-9]+$", "title": "Days", "type": "string"}, "fiscal_year": {"maxLength": 4096, "title": "Fiscal Year", "type": "string"}, "period_id": {"maxLength": 4096, "title": "Period Id", "type": "string"}, "unavailable_reason": {"anyOf": [{"maxLength": 4096, "type": "string"}, {"type": "null"}], "title": "Unavailable Reason"}, "values": {"items": {"$ref": "#/$defs/ModelValue"}, "maxItems": 40, "title": "Values", "type": "array"}}, "required": ["case", "period_id", "fiscal_year", "days", "values", "unavailable_reason"], "title": "ModelPeriod", "type": "object"},
  "ModelValue": {"additionalProperties": false, "properties": {"name": {"maxLength": 256, "title": "Name", "type": "string"}, "unavailable_reason": {"anyOf": [{"const": "ZERO_OR_NEGATIVE_DENOMINATOR", "type": "string"}, {"type": "null"}], "title": "Unavailable Reason"}, "value": {"anyOf": [{"maxLength": 64, "pattern": "^-?[0-9]+(\\.[0-9]+)?$", "type": "string"}, {"type": "null"}], "title": "Value"}}, "required": ["name", "value", "unavailable_reason"], "title": "ModelValue", "type": "object"},
  "NodeState": {"description": "The bundle's four. RESTRICTED runs; it is not \"degraded\" or \"partial\".", "enum": ["COMPLETE", "RUNNABLE", "RESTRICTED", "BLOCKED"], "title": "NodeState", "type": "string"},
  "NodeView": {"additionalProperties": false, "description": "A node's state and the reason for it.", "properties": {"awaiting_gate": {"title": "Awaiting Gate", "type": "boolean"}, "gate_verdict": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Gate Verdict"}, "module_id": {"maxLength": 256, "title": "Module Id", "type": "string"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "stage": {"title": "Stage", "type": "integer"}, "state": {"$ref": "#/$defs/NodeState"}, "waiting_on": {"items": {"$ref": "#/$defs/EdgeView"}, "maxItems": 256, "title": "Waiting On", "type": "array"}}, "required": ["route_node_id", "module_id", "stage", "state", "waiting_on", "awaiting_gate", "gate_verdict"], "title": "NodeView", "type": "object"},
  "PageBody": {"additionalProperties": false, "description": "The text layer of one page of a pinned live source of a run.", "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "document_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Document Sha256", "type": "string"}, "frame": {"$ref": "#/$defs/FrameView"}, "lines": {"items": {"$ref": "#/$defs/PageLine"}, "maxItems": 2000, "title": "Lines", "type": "array"}, "page": {"maximum": 500, "minimum": 1, "title": "Page", "type": "integer"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "source_id": {"format": "uuid", "title": "Source Id", "type": "string"}}, "required": ["case_id", "run_id", "source_id", "document_sha256", "page", "frame", "lines"], "title": "PageBody", "type": "object"},
  "PageDocument": {"additionalProperties": false, "description": "An evidence page. Not a section document, so it carries no chrome.", "properties": {"body": {"$ref": "#/$defs/PageBody"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["body", "observed_at", "status", "notes"], "title": "PageDocument", "type": "object"},
  "PageLine": {"additionalProperties": false, "description": "One line of the token index: joined text and its union rectangle.", "properties": {"text": {"maxLength": 65536, "title": "Text", "type": "string"}, "x0": {"title": "X0", "type": "number"}, "x1": {"title": "X1", "type": "number"}, "y0": {"title": "Y0", "type": "number"}, "y1": {"title": "Y1", "type": "number"}}, "required": ["text", "x0", "y0", "x1", "y1"], "title": "PageLine", "type": "object"},
  "PendingNode": {"additionalProperties": false, "properties": {"module_id": {"maxLength": 256, "title": "Module Id", "type": "string"}, "route_node_id": {"maxLength": 256, "title": "Route Node Id", "type": "string"}, "state": {"$ref": "#/$defs/NodeState"}}, "required": ["route_node_id", "module_id", "state"], "title": "PendingNode", "type": "object"},
  "PinRunInput": {"additionalProperties": false, "properties": {"subject": {"$ref": "#/$defs/RunSubjectView"}}, "required": ["subject"], "title": "PinRunInput", "type": "object"},
  "RectView": {"additionalProperties": false, "description": "A rectangle in page coordinates, from the record.", "properties": {"x0": {"title": "X0", "type": "number"}, "x1": {"title": "X1", "type": "number"}, "y0": {"title": "Y0", "type": "number"}, "y1": {"title": "Y1", "type": "number"}}, "required": ["x0", "y0", "x1", "y1"], "title": "RectView", "type": "object"},
  "RefusalBody": {"additionalProperties": false, "description": "Everything a declined request says: the code and what clears it.", "properties": {"clears": {"maxLength": 4096, "title": "Clears", "type": "string"}, "code": {"$ref": "#/$defs/RefusalCode"}}, "required": ["code", "clears"], "title": "RefusalBody", "type": "object"},
  "RefusalCode": {"description": "Every reason the host declines. Public-safe by construction.", "enum": ["BOUNDARY_TEXT_INVALID", "BOUNDARY_TEXT_TOO_LONG", "BLOB_DIGEST_MISMATCH", "BLOB_NOT_FOUND", "BLOB_ADDRESS_INVALID", "RUN_NOT_FOUND", "RUN_NOT_RUNNING", "LEASE_NOT_HELD", "RUN_CANCEL_REQUESTED", "RUN_NODES_UNACCEPTED", "RUN_TERMINAL_STALE", "ATTEMPT_NOT_FOUND", "ATTEMPT_LIMIT_REACHED", "CALL_OUTCOME_INVALID", "CALL_OUTCOME_CONFLICT", "CALL_OUTCOME_LEGACY", "NODE_ALREADY_ACCEPTED", "MONEY_NOT_DECIMAL", "MONEY_INVALID", "BUDGET_ALREADY_RESERVED", "BUDGET_NOT_RESERVED", "BUDGET_CEILING_REACHED", "PROVIDER_NOT_CONFIGURED", "PROVIDER_CALL_INVALID", "CONTEXT_OVER_CEILING", "PROVIDER_UNAVAILABLE", "PROVIDER_OUTPUT_TRUNCATED", "PROVIDER_REFUSED", "PROVIDER_RESPONSE_INVALID", "AUTHORITY_BYTES_MISMATCH", "AUTHORITY_MODULE_UNKNOWN", "ENVELOPE_INVALID", "ENVELOPE_UNDECLARED_FIELD", "ENVELOPE_UNCITED_CLAIM", "HANDOFF_MALFORMED", "HANDOFF_BLOCKED", "HANDOFF_IDENTITY_MISMATCH", "HANDOFF_INCOMPLETE", "HANDOFF_UNDECLARED_FIELD", "HANDOFF_MODULE_UNSUPPORTED", "ARTIFACT_RECORD_MISMATCH", "READINESS_INVALID", "READINESS_INCOMPLETE", "NOT_AUTHENTICATED", "ENDPOINT_NOT_FOUND", "EDGE_NOT_TRUSTED", "ORIGIN_REFUSED", "EDGE_CONFIG_INVALID", "INTERNAL_FAULT", "NOT_AUTHORISED", "REQUEST_INVALID", "IDEMPOTENCY_KEY_REQUIRED", "IDEMPOTENCY_KEY_REUSED", "RUN_INPUT_NOT_PINNED", "RUN_ALREADY_STARTED", "RUN_NOT_STOPPED", "ROUTE_NOT_ENABLED", "COMMAND_EXPECTATION_STALE", "METHODOLOGY_INPUT_INVALID", "FORECAST_CHAIN_BROKEN", "FORECAST_RESIDUAL_UNRECONCILED", "FORECAST_DRIVER_NOT_READY", "DELIVERABLE_PAYLOAD_INVALID", "DELIVERABLE_NOT_FOUND", "NARRATIVE_FIGURE_UNREFERENCED", "NARRATIVE_REFERENCE_INVALID", "DELIVERABLE_UNCITED_FIGURE", "DELIVERABLE_NOT_SIGNED", "DELIVERABLE_NOT_FROZEN", "DELIVERABLE_MOVED_SINCE_SIGNING", "DELIVERABLE_ALREADY_FILED", "DELIVERABLE_ALREADY_FROZEN", "APPROVER_NOT_INDEPENDENT", "CASE_NOT_FOUND", "SOURCE_PACK_EMPTY", "SOURCE_NOT_READABLE", "SOURCE_ENCRYPTED", "SOURCE_HAS_NO_TEXT", "SOURCE_TOO_LARGE", "SOURCE_EXTRACTION_TIMEOUT", "SOURCE_IDENTITY_INVALID", "EVIDENCE_NOT_AVAILABLE", "PAGE_NOT_AVAILABLE", "CITATION_NOT_LOCATED", "CITATION_AMBIGUOUS", "CITATION_NOT_DELIVERED", "ROUTE_PROFILE_UNKNOWN", "ROUTE_SELECTION_UNKNOWN", "ROUTE_EXTENSION_OWNER_MISSING", "ROUTE_HAS_A_CYCLE", "ROUTE_DUPLICATE_MODULE", "ROUTE_ALREADY_PINNED", "ROUTE_IDENTITY_INVALID", "ROUTE_PIN_TOO_LATE", "RUN_INPUT_INVALID", "RUN_INPUT_ALREADY_PINNED", "RUN_INPUT_TOO_LATE", "GATE_APPROVAL_MISMATCH", "QUALIFICATION_SET_EMPTY", "QUALIFICATION_KEY_UNANSWERABLE", "QUALIFICATION_SET_AMBIGUOUS", "QUALIFICATION_RUN_MISSING", "QUALIFICATION_SET_FILE_INVALID", "QUALIFICATION_SET_PATH_ESCAPES", "QUALIFICATION_SET_OVER_CEILING", "ORCHESTRATION_NOTHING_TO_PROVE", "ORCHESTRATION_ROUTE_NOT_PINNED", "ORCHESTRATION_NODE_NOT_IN_ROUTE", "ORCHESTRATION_BUILD_MOVED", "ORCHESTRATION_SOURCE_NOT_PINNED", "ORCHESTRATION_CITATION_LOST", "ORCHESTRATION_ARTIFACT_UNREADABLE", "VERDICT_INCOMPLETE", "VERDICT_BINDING_INVALID", "VERDICT_UNDECLARED_FIELD", "VERDICT_EXPIRED", "STORE_SCHEMA_DRIFT", "STORE_NOT_TRANSACTIONAL", "STORE_NOT_CONFIGURED", "STORE_UNAVAILABLE"], "title": "RefusalCode", "type": "string"},
  "RetryRun": {"additionalProperties": false, "properties": {"input_fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Input Fingerprint", "type": "string"}}, "required": ["input_fingerprint"], "title": "RetryRun", "type": "object"},
  "RouteChoice": {"additionalProperties": false, "description": "A (profile, selection) pair the adapter executes (`ADAPTER_ROUTES`).", "properties": {"profile_id": {"maxLength": 256, "title": "Profile Id", "type": "string"}, "selection_id": {"maxLength": 256, "title": "Selection Id", "type": "string"}}, "required": ["profile_id", "selection_id"], "title": "RouteChoice", "type": "object"},
  "RunBody": {"additionalProperties": false, "description": "Latest and displayed run are separate identities (item 1).", "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "displayed_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Displayed Run Id"}, "latest_run_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Latest Run Id"}, "route_choices": {"items": {"$ref": "#/$defs/RouteChoice"}, "maxItems": 16, "title": "Route Choices", "type": "array"}, "run": {"anyOf": [{"$ref": "#/$defs/RunView"}, {"type": "null"}]}, "runs": {"items": {"$ref": "#/$defs/RunSummary"}, "maxItems": 200, "title": "Runs", "type": "array"}}, "required": ["case_id", "latest_run_id", "displayed_run_id", "runs", "run", "route_choices"], "title": "RunBody", "type": "object"},
  "RunCreated": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "route_digest": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Route Digest", "type": "string"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}}, "required": ["case_id", "run_id", "route_digest"], "title": "RunCreated", "type": "object"},
  "RunInputPinned": {"additionalProperties": false, "properties": {"input_fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Input Fingerprint", "type": "string"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "source_set_version": {"title": "Source Set Version", "type": "integer"}}, "required": ["run_id", "source_set_version", "input_fingerprint"], "title": "RunInputPinned", "type": "object"},
  "RunSectionDocument": {"additionalProperties": false, "properties": {"body": {"$ref": "#/$defs/RunBody"}, "chrome": {"$ref": "#/$defs/Chrome"}, "notes": {"items": {"$ref": "#/$defs/SectionNote"}, "maxItems": 3, "title": "Notes", "type": "array"}, "observed_at": {"format": "date-time", "title": "Observed At", "type": "string"}, "observed_empty": {"title": "Observed Empty", "type": "boolean"}, "status": {"enum": ["complete", "partial"], "title": "Status", "type": "string"}}, "required": ["chrome", "body", "observed_at", "observed_empty", "status", "notes"], "title": "RunSectionDocument", "type": "object"},
  "RunSubjectView": {"additionalProperties": false, "description": "The pinned run subject.", "properties": {"analysis_date": {"maxLength": 10, "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "title": "Analysis Date", "type": "string"}, "issuer_id": {"maxLength": 128, "title": "Issuer Id", "type": "string"}, "issuer_name": {"maxLength": 4096, "title": "Issuer Name", "type": "string"}, "reporting_period": {"maxLength": 4096, "title": "Reporting Period", "type": "string"}}, "required": ["issuer_id", "issuer_name", "reporting_period", "analysis_date"], "title": "RunSubjectView", "type": "object"},
  "RunSummary": {"additionalProperties": false, "description": "One run of a case, as a list names it.", "properties": {"created_at": {"format": "date-time", "title": "Created At", "type": "string"}, "profile_id": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Profile Id"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "selection_id": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Selection Id"}, "status": {"enum": ["RUNNING", "COMPLETE", "FAILED", "BLOCKED", "CANCELLED"], "title": "Status", "type": "string"}}, "required": ["run_id", "status", "created_at", "profile_id", "selection_id"], "title": "RunSummary", "type": "object"},
  "RunView": {"additionalProperties": false, "description": "The displayed run. Node states are recomputed, never stored.", "properties": {"attempts": {"items": {"$ref": "#/$defs/AttemptView"}, "maxItems": 4096, "title": "Attempts", "type": "array"}, "build_id": {"anyOf": [{"maxLength": 256, "type": "string"}, {"type": "null"}], "title": "Build Id"}, "created_at": {"format": "date-time", "title": "Created At", "type": "string"}, "gates": {"items": {"$ref": "#/$defs/GateView"}, "maxItems": 2, "title": "Gates", "type": "array"}, "nodes": {"items": {"$ref": "#/$defs/NodeView"}, "maxItems": 256, "title": "Nodes", "type": "array"}, "route_digest": {"anyOf": [{"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}], "title": "Route Digest"}, "run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "source_set_version": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Source Set Version"}, "status": {"enum": ["RUNNING", "COMPLETE", "FAILED", "BLOCKED", "CANCELLED"], "title": "Status", "type": "string"}, "subject": {"anyOf": [{"$ref": "#/$defs/RunSubjectView"}, {"type": "null"}]}, "work": {"anyOf": [{"$ref": "#/$defs/WorkView"}, {"type": "null"}]}}, "required": ["run_id", "status", "created_at", "route_digest", "build_id", "source_set_version", "subject", "gates", "nodes", "attempts", "work"], "title": "RunView", "type": "object"},
  "RunWork": {"additionalProperties": false, "properties": {"run_id": {"format": "uuid", "title": "Run Id", "type": "string"}, "run_status": {"enum": ["RUNNING", "COMPLETE", "FAILED", "BLOCKED", "CANCELLED"], "title": "Run Status", "type": "string"}, "work": {"$ref": "#/$defs/WorkView"}}, "required": ["run_id", "run_status", "work"], "title": "RunWork", "type": "object"},
  "SectionNote": {"description": "Why a section document is partial or empty. Closed.", "enum": ["LIST_TRUNCATED", "ROUTE_NOT_PINNED", "HANDOFFS_PENDING"], "title": "SectionNote", "type": "string"},
  "ServedRole": {"additionalProperties": false, "description": "Who the server answered as. Shown, and enables nothing (decision 5).", "properties": {"global_role": {"$ref": "#/$defs/GlobalRole"}, "standing": {"anyOf": [{"$ref": "#/$defs/Standing"}, {"type": "null"}]}}, "required": ["global_role", "standing"], "title": "ServedRole", "type": "object"},
  "SetVersion": {"additionalProperties": false, "properties": {"fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Fingerprint", "type": "string"}, "member_count": {"title": "Member Count", "type": "integer"}, "version": {"title": "Version", "type": "integer"}}, "required": ["version", "fingerprint", "member_count"], "title": "SetVersion", "type": "object"},
  "SourceRow": {"additionalProperties": false, "description": "One admitted source; withdrawal is read live.", "properties": {"admitted_at": {"format": "date-time", "title": "Admitted At", "type": "string"}, "document_sha256": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Document Sha256", "type": "string"}, "extractor_identity": {"anyOf": [{"maxLength": 4096, "type": "string"}, {"type": "null"}], "title": "Extractor Identity"}, "filename": {"maxLength": 4096, "title": "Filename", "type": "string"}, "set_versions": {"items": {"type": "integer"}, "maxItems": 1000, "title": "Set Versions", "type": "array"}, "source_id": {"format": "uuid", "title": "Source Id", "type": "string"}, "withdrawn_at": {"anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}], "title": "Withdrawn At"}}, "required": ["source_id", "filename", "document_sha256", "admitted_at", "withdrawn_at", "extractor_identity", "set_versions"], "title": "SourceRow", "type": "object"},
  "SourcesAdmitted": {"additionalProperties": false, "properties": {"case_id": {"format": "uuid", "title": "Case Id", "type": "string"}, "source_ids": {"items": {"format": "uuid", "type": "string"}, "maxItems": 50, "title": "Source Ids", "type": "array"}}, "required": ["case_id", "source_ids"], "title": "SourcesAdmitted", "type": "object"},
  "Standing": {"description": "What a member may do on one case, least to most.", "enum": ["READER", "WRITER", "APPROVER", "ADMIN"], "title": "Standing", "type": "string"},
  "StartRun": {"additionalProperties": false, "properties": {"input_fingerprint": {"maxLength": 64, "pattern": "^[0-9a-f]{64}$", "title": "Input Fingerprint", "type": "string"}}, "required": ["input_fingerprint"], "title": "StartRun", "type": "object"},
